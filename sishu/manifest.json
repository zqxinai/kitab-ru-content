  "front_matter": [
    {
      "body_indonesian": "Guruku Chengzi - Thiacu berkata, \"Da Xue - Thai Hak ini adalah Kitab Warisan Mulia kaum Kong - Khong yang merupakan Ajaran Permulaan untuk masuk Pintu Gerbang Kebajikan. Dengan ini akan dapat diketahui urutan cara belajar orang-orang jaman dahulu. Hanya oleh terpeliharanya Kitab ini, selanjutnya dapat dipelajari baik-baik Kitab Lun Yu - Lun Gi dan Kitab Mengzi - Bingcu. Maka yang bermaksud belajar hendaklah mulai dengan bagian ini. Dengan demikian tidak akan keliru.\"",
      "book": "daxue",
      "editorial_status": "unverified-draft",
      "id": "sishu.daxue.preface",
      "source_file": "01 - Da Xue 大學/00 - Kata Pengantar Zhu Xi.md",
      "title": "Kata Pengantar Zhu Xi - Cu Hi"
    },
    {
      "body_indonesian": "Guruku Chengzi - Thiacu berkata, \"Yang tidak menyeleweng dinamai Tengah, yang tidak berubah dinamai Sempurna. Tengah itulah Jalan Lurus dunia dan Sempurna itulah Hukum Tetap bagi dunia. Kitab ini berisi ajaran rohani pemeluk Agama Khonghucu. Zisi - Cusu (Kong Ji - Khong Khiep, cucu Nabi Kongzi - Khongcu) khawatir lama kelamaan akan berkurang isinya, maka dibukukan untuk diserahkan kepada Mengzi - Bingcu. Kitab ini mula-mula membicarakan tentang Satu Hukum, lalu dibentangkan sampai meliputi berlaksa perkara dan akhirnya dikembalikan menjadi Satu Hukum. Ajaran ini bila diuraikan akan meliputi enam penjuru, bila diringkas akan balik tersembunyi ke alam gaib. Sari ajarannya tidak pernah habis dan semuanya berisi ajaran nyata. Yang dapat baik-baik membacanya, sehingga memperoleh sarinya, akan dapat memakainya sepanjang hidup dan tidak dapat menghabiskannya.",
      "book": "zhongyong",
      "editorial_status": "unverified-draft",
      "id": "sishu.zhongyong.preface",
      "source_file": "02 - Zhong Yong 中庸/00 - Kata Pengantar Zhu Xi.md",
      "title": "Kata Pengantar Zhu Xi - Cu Hi"
