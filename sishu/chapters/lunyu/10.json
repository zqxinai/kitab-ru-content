h hormat dan tenang."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.03","number":3,"ruby_paragraphs":[[{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"zhào","traditional":"召","type":"ruby"},{"pinyin":"shǐ","traditional":"使","type":"ruby"},{"modern":"摈","pinyin":"bìn","traditional":"擯","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"pinyin":"bó","traditional":"勃","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"pinyin":"jué","traditional":"躩","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"yī","traditional":"揖","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"modern":"与","pinyin":"yǔ","traditional":"與","type":"ruby"},{"pinyin":"lì","traditional":"立","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zuǒ","traditional":"左","type":"ruby"},{"pinyin":"yòu","traditional":"右","type":"ruby"},{"pinyin":"shǒu","traditional":"手","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"pinyin":"qián","traditional":"前","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"chān","traditional":"襜","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"modern":"趋","pinyin":"qū","traditional":"趨","type":"ruby"},{"modern":"进","pinyin":"jìn","traditional":"進","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yì","traditional":"翼","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"modern":"宾","pinyin":"bīn","traditional":"賓","type":"ruby"},{"pinyin":"tuì","traditional":"退","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"复","pinyin":"fù","traditional":"復","type":"ruby"},{"pinyin":"mìng","traditional":"命","type":"ruby"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"modern":"宾","pinyin":"bīn","traditional":"賓","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"顾","pinyin":"gù","traditional":"顧","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。”"}]],"translation_indonesian":"Pada waktu ditugaskan menyambut tamu, nampak perubahan pada wajahnya dan tindakan kakinya tenang. (2) Setelah berhadapan (dengan tamu) dan saling memberi iep, sekalipun mengangkat tangan menghadap ke kiri dan ke kanan, pakaiannya bagian muka maupun belakang tetap nampak rapi. (3) Pada waktu maju menyambut, sikap jalannya sangat indah, tangannya seperti burung membentangkan sayap. (4) Setelah tamu pergi, selalu memberi laporan, \"Para tamu sudah tidak menoleh lagi.\""},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.04","number":4,"ruby_paragraphs":[[{"pinyin":"rù","traditional":"入","type":"ruby"},{"pinyin":"gōng","traditional":"公","type":"ruby"},{"modern":"门","pinyin":"mén","traditional":"門","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jū","traditional":"鞠","type":"ruby"},{"pinyin":"gōng","traditional":"躬","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"róng","traditional":"容","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"lì","traditional":"立","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zhōng","traditional":"中","type":"ruby"},{"modern":"门","pinyin":"mén","traditional":"門","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"lǚ","traditional":"履","type":"ruby"},{"modern":"阈","pinyin":"yù","traditional":"閾","type":"ruby"},{"type":"text","value":"。"},{"modern":"过","pinyin":"guò","traditional":"過","type":"ruby"},{"pinyin":"wèi","traditional":"位","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"pinyin":"bó","traditional":"勃","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"pinyin":"jué","traditional":"躩","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"pinyin":"sì","traditional":"似","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"。"},{"modern":"摄","pinyin":"shè","traditional":"攝","type":"ruby"},{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"pinyin":"shēng","traditional":"升","type":"ruby"},{"pinyin":"táng","traditional":"堂","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jū","traditional":"鞠","type":"ruby"},{"pinyin":"gōng","traditional":"躬","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"píng","traditional":"屏","type":"ruby"},{"modern":"气","pinyin":"qì","traditional":"氣","type":"ruby"},{"pinyin":"sì","traditional":"似","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"xī","traditional":"息","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"chū","traditional":"出","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jiàng","traditional":"降","type":"ruby"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"děng","traditional":"等","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"chěng","traditional":"逞","type":"ruby"},{"modern":"颜","pinyin":"yán","traditional":"顏","type":"ruby"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yí","traditional":"怡","type":"ruby"},{"pinyin":"yí","traditional":"怡","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"；"},{"modern":"没","pinyin":"méi","traditional":"沒","type":"ruby"},{"modern":"阶","pinyin":"jiē","traditional":"階","type":"ruby"},{"type":"text","value":"，"},{"modern":"趋","pinyin":"qū","traditional":"趨","type":"ruby"},{"modern":"进","pinyin":"jìn","traditional":"進","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yì","traditional":"翼","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"；"},{"modern":"复","pinyin":"fù","traditional":"復","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"wèi","traditional":"位","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"cù","traditional":"踧","type":"ruby"},{"pinyin":"jí","traditional":"踖","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu masuk pintu gerbang, jalanNya membongkok seolah-olah tempatnya tidak leluasa. (2) Pada waktu berdiri tidak pernah di tengah pintu, dan pada waktu melaluinya tidak menginjak ambang pintu. (3) Pada waktu melewati takhta, wajahnya nampak berubah, kakinya agak ditekuk, dan kata- kataNya terdengar perlahan. (4) Pada waktu menaiki balairung, jubahNya diangkat dengan rapi, badanNya membongkok, napasNya ditahan seolah-olah tidak bernapas. (5) Pada waktu turun kembali, begitu turun di tingkat pertama, wajahNya nampak gembira dan sikapNya lebih leluasa. Setelah sampai di bawah, cepat-cepat berjalan dengan tangan seperti burung membentangkan sayap menuju tempatNya; dan sikapNya tetap hormat serta sedap dipandang."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.05","number":5,"ruby_paragraphs":[[{"modern":"执","pinyin":"zhí","traditional":"執","type":"ruby"},{"pinyin":"guī","traditional":"圭","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jū","traditional":"鞠","type":"ruby"},{"pinyin":"gōng","traditional":"躬","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"胜","pinyin":"shèng","traditional":"勝","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"shàng","traditional":"上","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yī","traditional":"揖","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"shòu","traditional":"授","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"bó","traditional":"勃","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"modern":"战","pinyin":"zhàn","traditional":"戰","type":"ruby"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"pinyin":"sù","traditional":"蹜","type":"ruby"},{"pinyin":"sù","traditional":"蹜","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"xún","traditional":"循","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"xiǎng","traditional":"享","type":"ruby"},{"modern":"礼","pinyin":"lǐ","traditional":"禮","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"róng","traditional":"容","type":"ruby"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"sī","traditional":"私","type":"ruby"},{"modern":"觌","pinyin":"dí","traditional":"覿","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yú","traditional":"愉","type":"ruby"},{"pinyin":"yú","traditional":"愉","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu membawa tanda titah, jalanNya membongkok seolah-olah tidak kuat membawanya. Pada waktu mengangkat tanda titah itu ke atas, nampak sebagai orang menghormat dengan iep, dan pada waktu menurunkannya nampak sebagai orang menyerahkan sesuatu. Wajahnya juga nampak berubah penuh perhatian, tindakan kakiNya seolah-olah dibebani sesuatu. (2) Setelah menyerahkan tanda titah itu, barulah wajahNya nampak tenang. (3) Pada waktu bertemu dengan raja diluar dinas, wajahNya nampak sangat senang."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.06","number":6,"ruby_paragraphs":[[{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"modern":"绀","pinyin":"gàn","traditional":"紺","type":"ruby"},{"pinyin":"zōu","traditional":"緅","type":"ruby"},{"modern":"饰","pinyin":"shì","traditional":"飾","type":"ruby"},{"type":"text","value":"，"},{"modern":"红","pinyin":"hóng","traditional":"紅","type":"ruby"},{"pinyin":"zǐ","traditional":"紫","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"modern":"为","pinyin":"wèi","traditional":"為","type":"ruby"},{"modern":"亵","pinyin":"xiè","traditional":"褻","type":"ruby"},{"pinyin":"fú","traditional":"服","type":"ruby"},{"type":"text","value":"。"},{"modern":"当","pinyin":"dāng","traditional":"當","type":"ruby"},{"pinyin":"shǔ","traditional":"暑","type":"ruby"},{"pinyin":"zhěn","traditional":"袗","type":"ruby"},{"modern":"𫄨","pinyin":"chī","traditional":"絺","type":"ruby"},{"modern":"绤","pinyin":"xì","traditional":"綌","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"biǎo","traditional":"表","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"chū","traditional":"出","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"},{"modern":"缁","pinyin":"zī","traditional":"緇","type":"ruby"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"pinyin":"gāo","traditional":"羔","type":"ruby"},{"pinyin":"qiú","traditional":"裘","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"sù","traditional":"素","type":"ruby"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"pinyin":"ní","traditional":"麑","type":"ruby"},{"pinyin":"qiú","traditional":"裘","type":"ruby"},{"type":"text","value":"，"},{"modern":"黄","pinyin":"huáng","traditional":"黃","type":"ruby"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"pinyin":"hú","traditional":"狐","type":"ruby"},{"pinyin":"qiú","traditional":"裘","type":"ruby"},{"type":"text","value":"。"},{"modern":"亵","pinyin":"xiè","traditional":"褻","type":"ruby"},{"pinyin":"qiú","traditional":"裘","type":"ruby"},{"modern":"长","pinyin":"zhǎng","traditional":"長","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"duǎn","traditional":"短","type":"ruby"},{"pinyin":"yòu","traditional":"右","type":"ruby"},{"pinyin":"mèi","traditional":"袂","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"modern":"寝","pinyin":"qǐn","traditional":"寢","type":"ruby"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"type":"text","value":"，"},{"modern":"长","pinyin":"zhǎng","traditional":"長","type":"ruby"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"shēn","traditional":"身","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"bàn","traditional":"半","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"hú","traditional":"狐","type":"ruby"},{"pinyin":"háo","traditional":"貉","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"hòu","traditional":"厚","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"jū","traditional":"居","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"qù","traditional":"去","type":"ruby"},{"modern":"丧","pinyin":"sàng","traditional":"喪","type":"ruby"},{"type":"text","value":"，"},{"modern":"无","pinyin":"wú","traditional":"無","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"pèi","traditional":"佩","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"fēi","traditional":"非","type":"ruby"},{"pinyin":"wéi","traditional":"帷","type":"ruby"},{"pinyin":"shang","traditional":"裳","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"杀","pinyin":"shā","traditional":"殺","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"gāo","traditional":"羔","type":"ruby"},{"pinyin":"qiú","traditional":"裘","type":"ruby"},{"pinyin":"xuán","traditional":"玄","type":"ruby"},{"pinyin":"guān","traditional":"冠","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"diào","traditional":"吊","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"jí","traditional":"吉","type":"ruby"},{"pinyin":"yuè","traditional":"月","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"cháo","traditional":"朝","type":"ruby"},{"pinyin":"fú","traditional":"服","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"cháo","traditional":"朝","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Junzi - Kuncu tidak menggunakan warna ungu tua dan sawo tua untuk hiasan pakaian. (2) Bahkan untuk pakaian dalam biasa juga tidak digunakan warna merah atau kemerah- merahan. (3) Pada waktu musim panas dikenakan pakaian tidak rangkap dari kain katun, halus atau kasar, tetapi selalu dikenakan pakaian dalam. (4) Bila mengenakan pakaian luar berwarna hitam, pakaian dalamNya dibuat dari kulit kambing hitam. Bila mengenakan pakaian luar berwarna putih, pakaian dalamNya dibuat dari kulit rusa putih. Dan bila mengenakan pakaian luar berwarna kuning, pakaian dalamNya dibuat dari kulit rubah kuning. (5) Pakaian sehari-hari yang dibuat dari kulit, selalu dibuat lebih panjang dari yang umum, tetapi lengan kananNya dibuat agak pendek. (6) Pada waktu tidur selalu mengenakan pakaian yang satu setengah kali lebih panjang daripada badanNya. (7) Pakaian dari kulit rubah dipakai sebagai pakaian sehari-hari. (8) Kecuali pada saat berkabung, perhiasan dipakai. (9) Kecuali pakaian untuk sembahyang, pakaian dalamnya dipotong sempit diatas, longgar di bawah. (10) Pada waktu mengunjungi orang kematian, tidak dikenakan pakaian dari kulit kambing hitam atau topi berwarna hitam. (11) Tiap tanggal satu selalu mengenakan pakaian kebesaran menghadap ke istana."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.07","number":7,"ruby_paragraphs":[[{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"míng","traditional":"明","type":"ruby"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"布","type":"ruby"},{"type":"text","value":"。"},{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"变","pinyin":"biàn","traditional":"變","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jū","traditional":"居","type":"ruby"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"迁","pinyin":"qiān","traditional":"遷","type":"ruby"},{"pinyin":"zuò","traditional":"坐","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu bersuci diri, selalu mengenakan pakaian dari kain linan yang bersih. (2) Pada waktu bersuci diri, macam-makanNya diubah; begitu pula, tempat dudukNya berpindah dari tempat duduk yang biasa. (S.S. VII: 13)."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.08","number":8,"ruby_paragraphs":[[{"pinyin":"shí","traditional":"食","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"厌","pinyin":"yàn","traditional":"厭","type":"ruby"},{"pinyin":"jīng","traditional":"精","type":"ruby"},{"type":"text","value":"，"},{"modern":"脍","pinyin":"kuài","traditional":"膾","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"厌","pinyin":"yàn","traditional":"厭","type":"ruby"},{"modern":"细","pinyin":"xì","traditional":"細","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"pinyin":"yì","traditional":"饐","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"ài","traditional":"餲","type":"ruby"},{"type":"text","value":"，"},{"modern":"鱼","pinyin":"yú","traditional":"魚","type":"ruby"},{"modern":"馁","pinyin":"něi","traditional":"餒","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"ròu","traditional":"肉","type":"ruby"},{"modern":"败","pinyin":"bài","traditional":"敗","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"modern":"恶","pinyin":"è","traditional":"惡","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"chòu","traditional":"臭","type":"ruby"},{"modern":"恶","pinyin":"è","traditional":"惡","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"shī","traditional":"失","type":"ruby"},{"modern":"饪","pinyin":"rèn","traditional":"飪","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"时","pinyin":"shí","traditional":"時","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"gē","traditional":"割","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zhèng","traditional":"正","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"dé","traditional":"得","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"酱","pinyin":"jiàng","traditional":"醬","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"ròu","traditional":"肉","type":"ruby"},{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"pinyin":"duō","traditional":"多","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shǐ","traditional":"使","type":"ruby"},{"modern":"胜","pinyin":"shèng","traditional":"勝","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"modern":"气","pinyin":"qì","traditional":"氣","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"wéi","traditional":"唯","type":"ruby"},{"pinyin":"jiǔ","traditional":"酒","type":"ruby"},{"modern":"无","pinyin":"wú","traditional":"無","type":"ruby"},{"pinyin":"liàng","traditional":"量","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"jí","traditional":"及","type":"ruby"},{"modern":"乱","pinyin":"luàn","traditional":"亂","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"gū","traditional":"沽","type":"ruby"},{"pinyin":"jiǔ","traditional":"酒","type":"ruby"},{"pinyin":"shì","traditional":"市","type":"ruby"},{"pinyin":"pú","traditional":"脯","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"chè","traditional":"撤","type":"ruby"},{"pinyin":"jiāng","traditional":"姜","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"duō","traditional":"多","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Nasi lebih suka yang bersih, ikan daging lebih suka yang diiris halus. (2) Nasi yang hangus atau sudah basi, dan ikan atau daging yang sudah rusak, tidak dimakan. Makanan yang sudah jelek warnanya, tidak dimakan; yang sudah jelek baunya, tidak dimakan. Kalau salah cara memasaknya, tidak dimakan. Kalau bukan saatnya tidak dimakan. (3) Daging yang salah memotong-motongnya, tidak dimakan, yang bumbunya tidak semestinya, tidak dimakan. (4) Meski terhidang banyak daging, tidak dimakan melebihi nasinya. Minum anggur tidak dibatasi, tetapi tidak sampai mabuk. (S.S. IX: 16). (5) Anggur dan daging kering yang dibeli dari pasar, tidak dimakan. (6) Pada waktu makan mesti ada jahe. (7) Makan tidak banyak-banyak."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.09","number":9,"ruby_paragraphs":[[{"pinyin":"jì","traditional":"祭","type":"ruby"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"pinyin":"gōng","traditional":"公","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"sù","traditional":"宿","type":"ruby"},{"pinyin":"ròu","traditional":"肉","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"jì","traditional":"祭","type":"ruby"},{"pinyin":"ròu","traditional":"肉","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"chū","traditional":"出","type":"ruby"},{"pinyin":"sān","traditional":"三","type":"ruby"},{"pinyin":"rì","traditional":"日","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"chū","traditional":"出","type":"ruby"},{"pinyin":"sān","traditional":"三","type":"ruby"},{"pinyin":"rì","traditional":"日","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Daging sisa sembahyang pemberian pangeran tidak dibiarkan sampai menginap. Daging sisa sembahyang lainnya tidak dibiarkan sampai tiga hari. Kalau lebih dari tiga hari, tidak dimakan."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.10","number":10,"ruby_paragraphs":[[{"pinyin":"shí","traditional":"食","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"语","pinyin":"yǔ","traditional":"語","type":"ruby"},{"type":"text","value":"，"},{"modern":"寝","pinyin":"qǐn","traditional":"寢","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu makan tidak bercakap-cakap; pada waktu akan tidur tidak bicara."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.11","number":11,"ruby_paragraphs":[[{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"pinyin":"shū","traditional":"疏","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"pinyin":"cài","traditional":"菜","type":"ruby"},{"pinyin":"gēng","traditional":"羹","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"guā","traditional":"瓜","type":"ruby"},{"pinyin":"jì","traditional":"祭","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Meskipun makan nasi dengan sayur yang sangat sederhana, niscaya disembahyangkan. Sembahyang dilakukan dengan sungguh-sungguh."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.12","number":12,"ruby_paragraphs":[[{"pinyin":"xí","traditional":"席","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zhèng","traditional":"正","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zuò","traditional":"坐","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Tikar duduk yang tidak teratur rapi, tidak diduduki."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.13","number":13,"ruby_paragraphs":[[{"modern":"乡","pinyin":"xiāng","traditional":"鄉","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"modern":"饮","pinyin":"yǐn","traditional":"飲","type":"ruby"},{"pinyin":"jiǔ","traditional":"酒","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zhàng","traditional":"杖","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"chū","traditional":"出","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"sī","traditional":"斯","type":"ruby"},{"pinyin":"chū","traditional":"出","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu berpesta di kampung, setelah orang-orang yang membawa tongkat ke luar, baru ikut ke luar."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.14","number":14,"ruby_paragraphs":[[{"modern":"乡","pinyin":"xiāng","traditional":"鄉","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"modern":"傩","pinyin":"nuó","traditional":"儺","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"cháo","traditional":"朝","type":"ruby"},{"pinyin":"fú","traditional":"服","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"lì","traditional":"立","type":"ruby"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"pinyin":"zuò","traditional":"阼","type":"ruby"},{"modern":"阶","pinyin":"jiē","traditional":"階","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu orang-orang kampung mengadakan upacara mengusir penyakit, Beliau selalu mengenakan pakaian kebesaran dan berdiri di atas tangga sebelah timur."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.15","number":15,"ruby_paragraphs":[[{"modern":"问","pinyin":"wèn","traditional":"問","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"pinyin":"tā","traditional":"他","type":"ruby"},{"pinyin":"bāng","traditional":"邦","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zài","traditional":"再","type":"ruby"},{"pinyin":"bài","traditional":"拜","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"sòng","traditional":"送","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu mengirim ucapan selamat kepada seseorang di negeri lain, orang yang disuruh diberi hormat dua kali baru disilakan berangkat."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.16","number":16,"ruby_paragraphs":[[{"pinyin":"kāng","traditional":"康","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"modern":"馈","pinyin":"kuì","traditional":"饋","type":"ruby"},{"modern":"药","pinyin":"yào","traditional":"藥","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bài","traditional":"拜","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"shòu","traditional":"受","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"qiū","traditional":"丘","type":"ruby"},{"pinyin":"wèi","traditional":"未","type":"ruby"},{"modern":"达","pinyin":"dá","traditional":"達","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"gǎn","traditional":"敢","type":"ruby"},{"modern":"尝","pinyin":"cháng","traditional":"嘗","type":"ruby"},{"type":"text","value":"。”"}]],"translation_indonesian":"Pada waktu Ji Kangzi - Kwi Khongcu memberi antaran semacam obat, dengan hormat dan terima kasih Nabi bersabda, \"Aku belum mengenal obat ini. Aku tidak berani meminumnya.\""},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.17","number":17,"ruby_paragraphs":[[{"modern":"厩","pinyin":"jiù","traditional":"廄","type":"ruby"},{"pinyin":"fén","traditional":"焚","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"tuì","traditional":"退","type":"ruby"},{"pinyin":"cháo","traditional":"朝","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"modern":"伤","pinyin":"shāng","traditional":"傷","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"type":"text","value":"？”"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"问","pinyin":"wèn","traditional":"問","type":"ruby"},{"modern":"马","pinyin":"mǎ","traditional":"馬","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu Beliau berada di istana, kandang kuda terbakar, setelah pulang Beliau bertanya, \"Adakah orang yang terluka?\" Beliau tidak menanyakan tentang kudanya."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.18","number":18,"ruby_paragraphs":[[{"pinyin":"jūn","traditional":"君","type":"ruby"},{"modern":"赐","pinyin":"cì","traditional":"賜","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"zhèng","traditional":"正","type":"ruby"},{"pinyin":"xí","traditional":"席","type":"ruby"},{"pinyin":"xiān","traditional":"先","type":"ruby"},{"modern":"尝","pinyin":"cháng","traditional":"嘗","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"modern":"赐","pinyin":"cì","traditional":"賜","type":"ruby"},{"pinyin":"xīng","traditional":"腥","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"shú","traditional":"熟","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"荐","pinyin":"jiàn","traditional":"薦","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"modern":"赐","pinyin":"cì","traditional":"賜","type":"ruby"},{"pinyin":"shēng","traditional":"生","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"chù","traditional":"畜","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"shì","traditional":"侍","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"jì","traditional":"祭","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xiān","traditional":"先","type":"ruby"},{"modern":"饭","pinyin":"fàn","traditional":"飯","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Bila raja mengantariNya makanan, niscaya dengan duduk rapi lebih dahulu baharulah kemudian mencicipinya. (2) Bila diantari daging mentah, segera dimasak lalu disembahyangkan kepada leluhurNya. (3) Kalau diantari hewan hidup niscaya dipeliharanya. (4) Kalau makan bersama raja, pada saat raja masih melakukan upacara sembahyang, lebih dahulu makan nasinya."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.19","number":19,"ruby_paragraphs":[[{"pinyin":"jí","traditional":"疾","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"modern":"视","pinyin":"shì","traditional":"視","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"，"},{"modern":"东","pinyin":"dōng","traditional":"東","type":"ruby"},{"pinyin":"shǒu","traditional":"首","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jiā","traditional":"加","type":"ruby"},{"pinyin":"cháo","traditional":"朝","type":"ruby"},{"pinyin":"fú","traditional":"服","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"tuō","traditional":"拖","type":"ruby"},{"modern":"绅","pinyin":"shēn","traditional":"紳","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu sakit, bila raja datang menjengukNya, niscaya menghadapkan kepalaNya ke arah Timur; pakaian kerajaanNya ditutupkan pada tubuh dan ditaruhi ikat pinggang kebesaranNya."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.20","number":20,"ruby_paragraphs":[[{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"mìng","traditional":"命","type":"ruby"},{"pinyin":"zhào","traditional":"召","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"qí","traditional":"俟","type":"ruby"},{"modern":"驾","pinyin":"jià","traditional":"駕","type":"ruby"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Bila mendapat panggilan raja, dengan tidak menantikan kereta siap, lebih dahulu berangkat. (Bc. VB. 8/9)."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.21","number":21,"ruby_paragraphs":[[{"pinyin":"rù","traditional":"入","type":"ruby"},{"pinyin":"tài","traditional":"太","type":"ruby"},{"modern":"庙","pinyin":"miào","traditional":"廟","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"měi","traditional":"每","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"modern":"问","pinyin":"wèn","traditional":"問","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu berada di Bio Besar, segala sesuatu ditanyakan lebih dahulu. (S.S. III: 15)."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.22","number":22,"ruby_paragraphs":[[{"pinyin":"péng","traditional":"朋","type":"ruby"},{"pinyin":"yǒu","traditional":"友","type":"ruby"},{"pinyin":"sǐ","traditional":"死","type":"ruby"},{"type":"text","value":"，"},{"modern":"无","pinyin":"wú","traditional":"無","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"modern":"归","pinyin":"guī","traditional":"歸","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"pinyin":"wǒ","traditional":"我","type":"ruby"},{"modern":"殡","pinyin":"bìn","traditional":"殯","type":"ruby"},{"type":"text","value":"。”"}]],"translation_indonesian":"Bila ada kawan yang meninggal dunia dan tidak mempunyai waris, Nabi bersabda, \"Tugaskulah untuk menguburnya.\""},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.23","number":23,"ruby_paragraphs":[[{"pinyin":"péng","traditional":"朋","type":"ruby"},{"pinyin":"yǒu","traditional":"友","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"馈","pinyin":"kuì","traditional":"饋","type":"ruby"},{"type":"text","value":"，"},{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"modern":"车","pinyin":"chē","traditional":"車","type":"ruby"},{"modern":"马","pinyin":"mǎ","traditional":"馬","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"fēi","traditional":"非","type":"ruby"},{"pinyin":"jì","traditional":"祭","type":"ruby"},{"pinyin":"ròu","traditional":"肉","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"bài","traditional":"拜","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Bila ada kawan yang memberi antaran, meskipun berupa kereta atau kuda, kalau bukan daging sisa sembahyang, tidak dilakukan penghormatan pai untuk menerimanya."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.24","number":24,"ruby_paragraphs":[[{"modern":"寝","pinyin":"qǐn","traditional":"寢","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"shī","traditional":"尸","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jū","traditional":"居","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"róng","traditional":"容","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu tidur tidak terlentang seperti mayat. Pada waktu di rumah tidak bersikap dinas."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.25","number":25,"ruby_paragraphs":[[{"modern":"见","pinyin":"jiàn","traditional":"見","type":"ruby"},{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"pinyin":"shuāi","traditional":"衰","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"，"},{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"pinyin":"xiá","traditional":"狎","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"变","pinyin":"biàn","traditional":"變","type":"ruby"},{"type":"text","value":"。"},{"modern":"见","pinyin":"jiàn","traditional":"見","type":"ruby"},{"pinyin":"miǎn","traditional":"冕","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"modern":"与","pinyin":"yǔ","traditional":"與","type":"ruby"},{"pinyin":"gǔ","traditional":"瞽","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"，"},{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"modern":"亵","pinyin":"xiè","traditional":"褻","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"mào","traditional":"貌","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"xiōng","traditional":"凶","type":"ruby"},{"pinyin":"fú","traditional":"服","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"shì","traditional":"式","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shì","traditional":"式","type":"ruby"},{"modern":"负","pinyin":"fù","traditional":"負","type":"ruby"},{"pinyin":"bǎn","traditional":"版","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"。"}],[{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"shèng","traditional":"盛","type":"ruby"},{"modern":"馔","pinyin":"zhuàn","traditional":"饌","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"变","pinyin":"biàn","traditional":"變","type":"ruby"},{"pinyin":"sè","traditional":"色","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"zuò","traditional":"作","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"xùn","traditional":"迅","type":"ruby"},{"pinyin":"léi","traditional":"雷","type":"ruby"},{"modern":"风","pinyin":"fēng","traditional":"風","type":"ruby"},{"pinyin":"liè","traditional":"烈","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"modern":"变","pinyin":"biàn","traditional":"變","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu bertemu dengan orang yang mengenakan pakaian berkabung, meskipun sudah sering dijumpaiNya, selalu tampak perubahan pada wajahNya. (S.S. IX: 10). (2) Pada waktu bertemu dengan orang yang mengenakan topi kebesaran atau orang buta, meski berpakaian biasa, selalu diberiNya hormat. (3) Pada waktu bertemu dengan orang yang berkabung, meski naik kereta, niscaya membongkokkan badan dan kedua tanganNya memegang palang kayu kereta. (4) Bila berjumpa dengan orang yang mendukung berkas Daftar Penduduk, juga demikian. (5) Kalau mendapat suguhan yang banyak macamnya, niscaya berubah wajahNya dan berdiri. (6) Pada waktu mendengar halilintar atau angin ribut, niscaya berubah wajah."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.26","number":26,"ruby_paragraphs":[[{"pinyin":"shēng","traditional":"升","type":"ruby"},{"modern":"车","pinyin":"chē","traditional":"車","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bì","traditional":"必","type":"ruby"},{"pinyin":"zhèng","traditional":"正","type":"ruby"},{"pinyin":"lì","traditional":"立","type":"ruby"},{"type":"text","value":"，"},{"modern":"执","pinyin":"zhí","traditional":"執","type":"ruby"},{"modern":"绥","pinyin":"suī","traditional":"綏","type":"ruby"},{"type":"text","value":"。"},{"modern":"车","pinyin":"chē","traditional":"車","type":"ruby"},{"pinyin":"zhōng","traditional":"中","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"内","pinyin":"nèi","traditional":"內","type":"ruby"},{"modern":"顾","pinyin":"gù","traditional":"顧","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"jí","traditional":"疾","type":"ruby"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"亲","pinyin":"qīn","traditional":"親","type":"ruby"},{"pinyin":"zhǐ","traditional":"指","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Pada waktu akan naik kereta, niscaya berdiri tegak lalu memegang tali kereta dan naik. Setelah di dalam kereta, tidak menengok-nengok ke bagian belakang kereta, tidak berbicara keras, dan tidak pula menunjuk-nunjuk."},{"editorial_status":"unverified-draft","id":"sishu.lunyu.10.27","number":27,"ruby_paragraphs":[[{"pinyin":"sè","traditional":"色","type":"ruby"},{"pinyin":"sī","traditional":"斯","type":"ruby"},{"modern":"举","pinyin":"jǔ","traditional":"舉","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xiáng","traditional":"翔","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"jí","traditional":"集","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"shān","traditional":"山","type":"ruby"},{"pinyin":"liáng","traditional":"梁","type":"ruby"},{"pinyin":"cí","traditional":"雌","type":"ruby"},{"pinyin":"zhì","traditional":"雉","type":"ruby"},{"type":"text","value":"，"},{"modern":"时","pinyin":"shí","traditional":"時","type":"ruby"},{"pinyin":"zāi","traditional":"哉","type":"ruby"},{"modern":"时","pinyin":"shí","traditional":"時","type":"ruby"},{"pinyin":"zāi","traditional":"哉","type":"ruby"},{"type":"text","value":"！”"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"lù","traditional":"路","type":"ruby"},{"pinyin":"gòng","traditional":"共","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"sān","traditional":"三","type":"ruby"},{"pinyin":"xiù","traditional":"嗅","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"zuò","traditional":"作","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"(Pada waktu Nabi bertamasya dengan Zi Lu - Cu Lo di suatu daerah pegunungan, melihat seekor ayam hutan). Ayam hutan itu mendadak terbang meninggi, berputar-putar lalu hinggap di atas jembatan. Melihat itu Nabi bersabda, \"Ayam hutan yang bersarang di bawah jembatan ini sungguh mengetahui gelagat, sungguh mengetahui gelagat!\" Mendengar kata-kata Nabi, Zi Lu - Cu Lo melakukan suatu gerakan dengan tangannya. Ayam hutan itu terkejut, berteriak tiga kali lalu terbang."}],"source_file":"03 - Lun Yu 論語/10 - Jilid X - Xiang Dang (Kampung) - 鄉黨篇.md","title":"Jilid X — Xiang Dang (Kampung) · 鄉黨篇"}
