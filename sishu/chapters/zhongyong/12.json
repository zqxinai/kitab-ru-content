:"ruby"},{"type":"text","value":"。"},{"pinyin":"fū","traditional":"夫","type":"ruby"},{"modern":"妇","pinyin":"fù","traditional":"婦","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"xiào","traditional":"肖","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"kě","traditional":"可","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"néng","traditional":"能","type":"ruby"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"pinyin":"yān","traditional":"焉","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jí","traditional":"及","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"zhì","traditional":"至","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"modern":"圣","pinyin":"shèng","traditional":"聖","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"pinyin":"yì","traditional":"亦","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"néng","traditional":"能","type":"ruby"},{"pinyin":"yān","traditional":"焉","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"dì","traditional":"地","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"dà","traditional":"大","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"modern":"犹","pinyin":"yóu","traditional":"猶","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"hàn","traditional":"憾","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"gù","traditional":"故","type":"ruby"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"modern":"语","pinyin":"yǔ","traditional":"語","type":"ruby"},{"pinyin":"dà","traditional":"大","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"mò","traditional":"莫","type":"ruby"},{"pinyin":"néng","traditional":"能","type":"ruby"},{"modern":"载","pinyin":"zài","traditional":"載","type":"ruby"},{"pinyin":"yān","traditional":"焉","type":"ruby"},{"type":"text","value":"，"},{"modern":"语","pinyin":"yǔ","traditional":"語","type":"ruby"},{"pinyin":"xiǎo","traditional":"小","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"mò","traditional":"莫","type":"ruby"},{"pinyin":"néng","traditional":"能","type":"ruby"},{"pinyin":"pò","traditional":"破","type":"ruby"},{"pinyin":"yān","traditional":"焉","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Seorang pria atau wanita bodoh sekalipun masih dapat memahaminya; tetapi untuk sampai ke puncaknya, sekalipun seorang Nabi takkan dapat memahami dengan sempurna. (S.S. XIV: 17). Seorang pria atau wanita yang sekalipun tidak pandai, masih dapat menjalankannya; tetapi untuk mencapai puncaknya, meskipun seorang Nabi takkan dapat menjalankannya dengan sempurna. Segenap hal di antara langit dan bumi yang besar ini, orang masih dapat mencatatnya. Maka, Jalan Suci seorang Junzi - Kuncu itu kalau dikatakan besar, tiada Benda di dunia ini yang dapat mendukungnya; kalau dikatakan kecil tiada alat di dunia ini yang dapat memecahnya."},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.12.03","number":3,"ruby_paragraphs":[[{"modern":"诗","pinyin":"shī","traditional":"詩","type":"ruby"},{"pinyin":"yún","traditional":"云","type":"ruby"},{"type":"text","value":"：“"},{"modern":"鸢","pinyin":"yuān","traditional":"鳶","type":"ruby"},{"modern":"飞","pinyin":"fēi","traditional":"飛","type":"ruby"},{"pinyin":"lì","traditional":"戾","type":"ruby"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"type":"text","value":"；"},{"modern":"鱼","pinyin":"yú","traditional":"魚","type":"ruby"},{"modern":"跃","pinyin":"yuè","traditional":"躍","type":"ruby"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"modern":"渊","pinyin":"yuān","traditional":"淵","type":"ruby"},{"type":"text","value":"。”"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"shàng","traditional":"上","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"chá","traditional":"察","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Di dalam Kitab Sanjak tertulis, 'Elang terbang meninggi langit, ikan menyelam menyusup air,' Kata-kata ini menunjukkan Kenyataan (Jalan Suci) itu dapat diteliti di atas maupun di bawah. (III. 1.5.3)"},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.12.04","number":4,"ruby_paragraphs":[[{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"dào","traditional":"道","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zào","traditional":"造","type":"ruby"},{"pinyin":"duān","traditional":"端","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"pinyin":"fū","traditional":"夫","type":"ruby"},{"modern":"妇","pinyin":"fù","traditional":"婦","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"jí","traditional":"及","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"zhì","traditional":"至","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"chá","traditional":"察","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"dì","traditional":"地","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Jalan Suci seorang Junzi - Kuncu dasarnya terdapat dalam hati tiap pria dan wanita, dan pada puncaknya meliputi segenap Kenyataan yang dapat diteliti di manapun diantara langit dan bumi.\" TENGAH SEMPURNA BAB XII (Jalan Suci itu Satya Dan Tepasarira)"}],"source_file":"02 - Zhong Yong 中庸/12 - Bab XI - Luasnya Jalan Suci.md","title":"Bab XI — Luasnya Jalan Suci"}
