by"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"yōng","traditional":"庸","type":"ruby"},{"pinyin":"dé","traditional":"德","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yōng","traditional":"庸","type":"ruby"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"谨","pinyin":"jǐn","traditional":"謹","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"gǎn","traditional":"敢","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"miǎn","traditional":"勉","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"modern":"余","pinyin":"yú","traditional":"餘","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"gǎn","traditional":"敢","type":"ruby"},{"modern":"尽","pinyin":"jǐn","traditional":"盡","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"modern":"顾","pinyin":"gù","traditional":"顧","type":"ruby"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"modern":"顾","pinyin":"gù","traditional":"顧","type":"ruby"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"jūn","traditional":"君","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"hú","traditional":"胡","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zào","traditional":"慥","type":"ruby"},{"pinyin":"zào","traditional":"慥","type":"ruby"},{"modern":"尔","pinyin":"ěr","traditional":"爾","type":"ruby"},{"type":"text","value":"。”"}]],"translation_indonesian":"\"Jalan Suci seorang Junzi - Kuncu ada empat yang khawatir belum satu Kulakukan. Apa yang Kuharapkan dari anakKu, belum dapat Kulakukan terhadap orang tuaKu; apa yang Kuharapkan dari menteriKu, belum dapat Kulakukan terhadap rajaKu; apa yang Kuharapkan dari adikKu, belum dapat Kulakukan terhadap kakakKu; dan apa yang Kuharapkan dari temanKu belum dapat Kuberikan lebih dahulu. Di dalam menjalankan Kebajikan Sempurna, di dalam berhati- hati membicarakannya, bila ada kekurangannya Aku tidak berani tidak sekuat tenaga mengusahakannya; dan bila ada yang berkelebihan Aku tidak berani menghamburkannya; maka di dalam berkata-kata selalu ingat akan perbuatan dan di dalam berbuat selalu ingat akan kata- kata. Bukankah demikian ketulusan hati seorang Junzi - Kuncu?\""}],"source_file":"02 - Zhong Yong 中庸/13 - Bab XII - Jalan Suci itu Satya dan Tepasarira.md","title":"Bab XII — Jalan Suci itu Satya dan Tepasarira"}
