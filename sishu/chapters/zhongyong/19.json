{"book":"zhongyong","id":"sishu.zhongyong.19","index":19,"passages":[{"editorial_status":"unverified-draft","id":"sishu.zhongyong.19.01","number":1,"ruby_paragraphs":[[{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"wǔ","traditional":"武","type":"ruby"},{"pinyin":"wáng","traditional":"王","type":"ruby"},{"type":"text","value":"、"},{"pinyin":"zhōu","traditional":"周","type":"ruby"},{"pinyin":"gōng","traditional":"公","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"达","pinyin":"dá","traditional":"達","type":"ruby"},{"pinyin":"xiào","traditional":"孝","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Nabi bersabda, \"Sungguh sempurna Laku Bakti Raja Wu - Bu dan Pangeran Ciu."},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.19.02","number":2,"ruby_paragraphs":[[{"pinyin":"fū","traditional":"夫","type":"ruby"},{"pinyin":"xiào","traditional":"孝","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shàn","traditional":"善","type":"ruby"},{"modern":"继","pinyin":"jì","traditional":"繼","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"zhì","traditional":"志","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shàn","traditional":"善","type":"ruby"},{"pinyin":"shù","traditional":"述","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Adapun yang dinamai berbakti ialah dapat baik-baik melanjutkan cita-cita mulia dan dapat baik-baik meneruskan pekerjaan mulia manusia/orang tuanya."},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.19.03","number":3,"ruby_paragraphs":[[{"pinyin":"chūn","traditional":"春","type":"ruby"},{"pinyin":"qiū","traditional":"秋","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xiū","traditional":"修","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"zǔ","traditional":"祖","type":"ruby"},{"modern":"庙","pinyin":"miào","traditional":"廟","type":"ruby"},{"type":"text","value":"，"},{"modern":"陈","pinyin":"chén","traditional":"陳","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"zōng","traditional":"宗","type":"ruby"},{"pinyin":"qì","traditional":"器","type":"ruby"},{"type":"text","value":"，"},{"modern":"设","pinyin":"shè","traditional":"設","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"shang","traditional":"裳","type":"ruby"},{"pinyin":"yī","traditional":"衣","type":"ruby"},{"type":"text","value":"，"},{"modern":"荐","pinyin":"jiàn","traditional":"薦","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"时","pinyin":"shí","traditional":"時","type":"ruby"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Di dalam Sembahyang Musim Semi dan Sembahyang Musim Rontok hendaklah dibangun kembali bio leluhur, diatur rapi barang-barang warisannya, diatur rapi pakaian-pakaiannya dan disajikan makanan sesuai dengan musimnya."},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.19.04","number":4,"ruby_paragraphs":[[{"pinyin":"zōng","traditional":"宗","type":"ruby"},{"modern":"庙","pinyin":"miào","traditional":"廟","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"礼","pinyin":"lǐ","traditional":"禮","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"xù","traditional":"序","type":"ruby"},{"pinyin":"zhāo","traditional":"昭","type":"ruby"},{"pinyin":"mù","traditional":"穆","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"xù","traditional":"序","type":"ruby"},{"pinyin":"jué","traditional":"爵","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"biàn","traditional":"辨","type":"ruby"},{"modern":"贵","pinyin":"guì","traditional":"貴","type":"ruby"},{"modern":"贱","pinyin":"jiàn","traditional":"賤","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"xù","traditional":"序","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"biàn","traditional":"辨","type":"ruby"},{"modern":"贤","pinyin":"xián","traditional":"賢","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"lǚ","traditional":"旅","type":"ruby"},{"pinyin":"chóu","traditional":"酬","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"modern":"为","pinyin":"wèi","traditional":"為","type":"ruby"},{"pinyin":"shàng","traditional":"上","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"dǎi","traditional":"逮","type":"ruby"},{"modern":"贱","pinyin":"jiàn","traditional":"賤","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"yàn","traditional":"燕","type":"ruby"},{"pinyin":"máo","traditional":"毛","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"xù","traditional":"序","type":"ruby"},{"modern":"齿","pinyin":"chǐ","traditional":"齒","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Di dalam upacara di bio leluhur, orang-orang yang sama she (marga) diatur kiri dan kanan, sehingga dapat dibedakan jauh dekat hubungan kekeluargaannya. Orang-orang dari marga lain dibagi menurut tingkat kedudukannya, sehingga dapat dibedakan tinggi rendah kedudukannya. Bagi para petugas diatur menurut tugasnya, sehingga dapat dibedakan kecakapannya. Kemudian para hadir saling memberi selamat, dengan pihak yang muda menyampaikan minuman kepada yang lebih tua. Dengan demikian pihak muda mendapat berkah. Apabila upacara itu telah selesai, lalu dibagilah tempat duduk menurut warna rambutnya, sehingga dapat dibedakan tingkat usianya."},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.19.05","number":5,"ruby_paragraphs":[[{"modern":"践","pinyin":"jiàn","traditional":"踐","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"wèi","traditional":"位","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xíng","traditional":"行","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"礼","pinyin":"lǐ","traditional":"禮","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zòu","traditional":"奏","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"乐","pinyin":"lè","traditional":"樂","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"jìng","traditional":"敬","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"zūn","traditional":"尊","type":"ruby"},{"type":"text","value":"，"},{"modern":"爱","pinyin":"ài","traditional":"愛","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"modern":"亲","pinyin":"qīn","traditional":"親","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"pinyin":"sǐ","traditional":"死","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"pinyin":"shēng","traditional":"生","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"pinyin":"wáng","traditional":"亡","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"pinyin":"cún","traditional":"存","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xiào","traditional":"孝","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"zhì","traditional":"至","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"\"Dengan demikian dapat memberi kedudukan kepada leluhur dan menjalankan upacara. Kemudian ditabuh musik leluhur dan menghormati yang diagungkan oleh leluhur, melayani kepada yang telah mangkat sebagai melayani yang masih hidup, melayani kepada yang sudah tiada sebagai melayani kepada yang masih ada. Demikianlah Laku Bakti yang sempurna."},{"editorial_status":"unverified-draft","id":"sishu.zhongyong.19.06","number":6,"ruby_paragraphs":[[{"pinyin":"jiāo","traditional":"郊","type":"ruby"},{"pinyin":"shè","traditional":"社","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"礼","pinyin":"lǐ","traditional":"禮","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"pinyin":"shàng","traditional":"上","type":"ruby"},{"pinyin":"dì","traditional":"帝","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"zōng","traditional":"宗","type":"ruby"},{"modern":"庙","pinyin":"miào","traditional":"廟","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"礼","pinyin":"lǐ","traditional":"禮","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"sì","traditional":"祀","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"xiān","traditional":"先","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"míng","traditional":"明","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"pinyin":"jiāo","traditional":"郊","type":"ruby"},{"pinyin":"shè","traditional":"社","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"礼","pinyin":"lǐ","traditional":"禮","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"dì","traditional":"禘","type":"ruby"},{"modern":"尝","pinyin":"cháng","traditional":"嘗","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"义","pinyin":"yì","traditional":"義","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zhì","traditional":"治","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"shì","traditional":"示","type":"ruby"},{"modern":"诸","pinyin":"zhū","traditional":"諸","type":"ruby"},{"pinyin":"zhǎng","traditional":"掌","type":"ruby"},{"pinyin":"hū","traditional":"乎","type":"ruby"},{"type":"text","value":"。”"}]],"translation_indonesian":"\"Dengan melakukan upacara Sembahyang Kau dan Sia, berarti melakukan pengabdian kepada Shangdi (SIANG TEE), Tuhan Yang Maha Tinggi; dengan melakukan upacara di bio leluhur berarti memberikan persembahan kepada nenek-moyang. Kalau orang dapat mengerti jelas makna Sembahyang Kau dan Sia serta makna Sembahyang Tee dan Siang, maka untuk mengatur negara laksana melihat tapak tangan saja.\" (S.S. III:10)."}],"source_file":"02 - Zhong Yong 中庸/19 - Bab XVIII - Sempurnanya Bakti.md","title":"Bab XVIII — Sempurnanya Bakti"}
