:"焉","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"āi","traditional":"哀","type":"ruby"},{"pinyin":"jīn","traditional":"矜","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"pì","traditional":"辟","type":"ruby"},{"pinyin":"yān","traditional":"焉","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"áo","traditional":"敖","type":"ruby"},{"pinyin":"duò","traditional":"惰","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"pì","traditional":"辟","type":"ruby"},{"pinyin":"yān","traditional":"焉","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"gù","traditional":"故","type":"ruby"},{"pinyin":"hǎo","traditional":"好","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"zhī","traditional":"知","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"恶","pinyin":"è","traditional":"惡","type":"ruby"},{"type":"text","value":"，"},{"modern":"恶","pinyin":"è","traditional":"惡","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"zhī","traditional":"知","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"měi","traditional":"美","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"modern":"鲜","pinyin":"xiān","traditional":"鮮","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Adapun yang dikatakan 'untuk membereskan rumah tangga harus lebih dahulu membina diri' itu ialah: di dalam mengasihi dan mencintai biasanya orang menyebelah; di dalam menghina dan membenci biasanya orang menyebelah; di dalam menjunjung dan menghormat biasanya orang menyebelah; di dalam menyedihi dan mengasihi biasanya orang menyebelah; dan di dalam merasa bangga dan agungpun biasanya orang menyebelah. Sesungguhnya orang yang dapat mengetahui keburukan pada apa-apa yang disukai dan dapat mengetahui kebaikan pada apa-apa yang dibencinya, amat jaranglah kita jumpai di dalam dunia ini."},{"editorial_status":"unverified-draft","id":"sishu.daxue.09.02","number":2,"ruby_paragraphs":[[{"pinyin":"gù","traditional":"故","type":"ruby"},{"modern":"谚","pinyin":"yàn","traditional":"諺","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"yuē","traditional":"曰","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"pinyin":"mò","traditional":"莫","type":"ruby"},{"pinyin":"zhī","traditional":"知","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"恶","pinyin":"è","traditional":"惡","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"mò","traditional":"莫","type":"ruby"},{"pinyin":"zhī","traditional":"知","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"miáo","traditional":"苗","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"modern":"硕","pinyin":"shuò","traditional":"碩","type":"ruby"},{"type":"text","value":"。”"}]],"translation_indonesian":"Maka di dalam peribahasa dikatakan, \"Orang tidak tahu keburukan anaknya, seperti petani tidak tahu kesuburan padinya.\""},{"editorial_status":"unverified-draft","id":"sishu.daxue.09.03","number":3,"ruby_paragraphs":[[{"pinyin":"cǐ","traditional":"此","type":"ruby"},{"modern":"谓","pinyin":"wèi","traditional":"謂","type":"ruby"},{"pinyin":"shēn","traditional":"身","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"xiū","traditional":"修","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"kě","traditional":"可","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"jiā","traditional":"家","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Inilah yang dikatakan, bahwa diri yang tidak terbina itu takkan sanggup membereskan rumah tangganya."}],"source_file":"01 - Da Xue 大學/09 - Bab VIII - Membina Diri Membereskan Rumah Tangga.md","title":"Bab VIII — Membina Diri Membereskan Rumah Tangga"}
