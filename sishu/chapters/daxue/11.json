y"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Maka seorang Junzi - Kuncu mempunyai Jalan Suci Yang Besar. Ingatlah hanya Satya dan Dapat Dipercaya sajalah memungkinkan kita mencapai cita-cita (yang mulia), sedangkan kesombongan dan keangkuhan akan mengakibatkan hilangnya harapan. (S.S. XIII: 26)"},{"editorial_status":"unverified-draft","id":"sishu.daxue.11.19","number":19,"ruby_paragraphs":[[{"pinyin":"shēng","traditional":"生","type":"ruby"},{"modern":"财","pinyin":"cái","traditional":"財","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"dà","traditional":"大","type":"ruby"},{"pinyin":"dào","traditional":"道","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shēng","traditional":"生","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"modern":"众","pinyin":"zhòng","traditional":"眾","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"shí","traditional":"食","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"guǎ","traditional":"寡","type":"ruby"},{"type":"text","value":"，"},{"modern":"为","pinyin":"wèi","traditional":"為","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"jí","traditional":"疾","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yòng","traditional":"用","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"shū","traditional":"舒","type":"ruby"},{"type":"text","value":"，"},{"modern":"则","pinyin":"zé","traditional":"則","type":"ruby"},{"modern":"财","pinyin":"cái","traditional":"財","type":"ruby"},{"modern":"恒","pinyin":"héng","traditional":"恆","type":"ruby"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Mengurus hartapun ada Jalannya Yang Besar; bila penghasilan lebih besar dari pada pemakaian dan bekerja setangkas mungkin sambil berhemat, niscaya harta benda itu akan terpelihara."},{"editorial_status":"unverified-draft","id":"sishu.daxue.11.20","number":20,"ruby_paragraphs":[[{"pinyin":"rén","traditional":"仁","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"modern":"财","pinyin":"cái","traditional":"財","type":"ruby"},{"modern":"发","pinyin":"fā","traditional":"發","type":"ruby"},{"pinyin":"shēn","traditional":"身","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"rén","traditional":"仁","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"shēn","traditional":"身","type":"ruby"},{"modern":"发","pinyin":"fā","traditional":"發","type":"ruby"},{"modern":"财","pinyin":"cái","traditional":"財","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Seorang yang penuh Cinta Kasih menggunakan harta untuk mengembangkan diri. Seorang yang tidak berperi Cinta Kasih, mengabdikan dirinya untuk menumpuk harta."},{"editorial_status":"unverified-draft","id":"sishu.daxue.11.21","number":21,"ruby_paragraphs":[[{"pinyin":"wèi","traditional":"未","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"shàng","traditional":"上","type":"ruby"},{"pinyin":"hǎo","traditional":"好","type":"ruby"},{"pinyin":"rén","traditional":"仁","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"hǎo","traditional":"好","type":"ruby"},{"modern":"义","pinyin":"yì","traditional":"義","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"wèi","traditional":"未","type":"ruby"},{"pinyin":"