":"zhī","traditional":"知","type":"ruby"},{"pinyin":"zài","traditional":"在","type":"ruby"},{"pinyin":"gé","traditional":"格","type":"ruby"},{"pinyin":"wù","traditional":"物","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Orang jaman dahulu yang hendak menggemilangkan Kebajikan Yang Bercahaya itu pada tiap umat di dunia, ia lebih dahulu berusaha mengatur negerinya; untuk mengatur negerinya, ia lebih dahulu membereskan rumah tangganya; untuk membereskan rumah tangganya, ia lebih dahulu membina dirinya; untuk membina dirinya, ia lebih dahulu meluruskan hatinya; untuk meluruskan hatinya, ia lebih dahulu mengimankan tekadnya; untuk mengimankan tekadnya, ia lebih dahulu mencukupkan pengetahuannya; dan untuk mencukupkan pengetahuannya, ia meneliti hakekat tiap perkara."},{"editorial_status":"unverified-draft","id":"sishu.daxue.01.05","number":5,"ruby_paragraphs":[[{"pinyin":"wù","traditional":"物","type":"ruby"},{"pinyin":"gé","traditional":"格","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"zhī","traditional":"知","type":"ruby"},{"pinyin":"zhì","traditional":"至","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zhī","traditional":"知","type":"ruby"},{"pinyin":"zhì","traditional":"至","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"yì","traditional":"意","type":"ruby"},{"modern":"诚","pinyin":"chéng","traditional":"誠","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yì","traditional":"意","type":"ruby"},{"modern":"诚","pinyin":"chéng","traditional":"誠","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"xīn","traditional":"心","type":"ruby"},{"pinyin":"zhèng","traditional":"正","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"xīn","traditional":"心","type":"ruby"},{"pinyin":"zhèng","traditional