aditional":"天","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"zhì","traditional":"至","type":"ruby"},{"modern":"于","pinyin":"yú","traditional":"於","type":"ruby"},{"pinyin":"shù","traditional":"庶","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yī","traditional":"壹","type":"ruby"},{"pinyin":"shì","traditional":"是","type":"ruby"},{"pinyin":"jiē","traditional":"皆","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"xiū","traditional":"修","type":"ruby"},{"pinyin":"shēn","traditional":"身","type":"ruby"},{"modern":"为","pinyin":"wèi","traditional":"為","type":"ruby"},{"pinyin":"běn","traditional":"本","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Karena itu dari raja sampai rakyat jelata mempunyai satu kewajiban yang sama, yaitu mengutamakan pembinaan diri sebagai pokok."},{"editorial_status":"unverified-draft","id":"sishu.daxue.01.07","number":7,"ruby_paragraphs":[[{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"běn","traditional":"本","type":"ruby"},{"modern":"乱","pinyin":"luàn","traditional":"亂","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"mò","traditional":"末","type":"ruby"},{"pinyin":"zhì","traditional":"治","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"fǒu","traditional":"否","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"hòu","traditional":"厚","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"báo","traditional":"薄","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pinyin":"báo","traditional":"薄","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"hòu","traditional":"厚","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"wèi","traditional":"未","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Adapun pokok yang kacau itu tidak pernah menghasilkan penyelesaian yang teratur baik, karena hal itu seumpama menipiskan benda yang seharusnya tebal dan menebalkan benda yang seharusnya tipis. Hal ini adalah sesuatu yang belum pernah terjadi."}],"source_file":"01 - Da Xue 大學/01 - Bab Utama.md","title":"Bab Utama"}
