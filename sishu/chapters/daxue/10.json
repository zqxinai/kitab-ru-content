ī","traditional":"詩","type":"ruby"},{"type":"text","value":"》"},{"pinyin":"yún","traditional":"云","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"yí","traditional":"宜","type":"ruby"},{"pinyin":"xiōng","traditional":"兄","type":"ruby"},{"pinyin":"yí","traditional":"宜","type":"ruby"},{"pinyin":"dì","traditional":"弟","type":"ruby"},{"type":"text","value":"。”"},{"pinyin":"yí","traditional":"宜","type":"ruby"},{"pinyin":"xiōng","traditional":"兄","type":"ruby"},{"pinyin":"yí","traditional":"宜","type":"ruby"},{"pinyin":"dì","traditional":"弟","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"kě","traditional":"可","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"jiào","traditional":"教","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Di dalam Kitab Sanjak tertulis, \"Hormatilah kakakmu, cintailah adikmu. Hormatilah kakakmu, cintailah adikmu.\" Dengan demikianlah baharu dapat mendidik rakyat negara. (II.2.6.3)"},{"editorial_status":"unverified-draft","id":"sishu.daxue.10.08","number":8,"ruby_paragraphs":[[{"type":"text","value":"《"},{"modern":"诗","pinyin":"shī","traditional":"詩","type":"ruby"},{"type":"text","value":"》"},{"pinyin":"yún","traditional":"云","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"仪","pinyin":"yí","traditional":"儀","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"tè","traditional":"忒","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"zhèng","traditional":"正","type":"ruby"},{"pinyin":"shì","traditional":"是","type":"ruby"},{"pinyin":"sì","traditional":"四","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"type":"text","value":"。”"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"为","pinyin":"wèi","traditional":"為","type":"ruby"},{"pinyin":"fù","traditional":"父","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"xiōng","traditional":"兄","type":"ruby"},{"pinyin":"dì","traditional":"弟","type":"ruby"},{"pinyin":"zú","traditional":"足","type":"ruby"},{"pinyin":"fǎ","traditional":"法","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"mín","traditional":"民","type":"ruby"},{"pinyin":"fǎ","traditional":"法","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Di dalam Kitab Sanjak tertulis \"Laku yang tanpa cacad itulah akan meluruskan hati rakyat di empat penjuru negara.\" Dapat melaksanakan tugas sebagai bapak, sebagai anak, sebagai kakak dan sebagai adik, baharulah kemudian dapat berharap rakyat meneladan kepadanya. (I.14.3.3.)"},{"editorial_status":"unverified-draft","id":"sishu.daxue.10.09","number":9,"ruby_paragraphs":[[{"pinyin":"cǐ","traditional":"此","type":"ruby"},{"modern":"谓","pinyin":"wèi","traditional":"謂","type":"ruby"},{"pinyin":"zhì","traditional":"治","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"pinyin":"zài","traditional":"在","type":"ruby"},{"modern":"齐","pinyin":"qí","traditional":"齊","type":"ruby"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"jiā","traditional":"家","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Inilah yang dikatakan mengatur negara itu berpangkal pada keberesan rumah tangga."}],"source_file":"01 - Da Xue 大學/10 - Bab IX - Membereskan Rumah Tangga Mengatur Negara.md","title":"Bab IX — Membereskan Rumah Tangga Mengatur Negara"}
