曰","type":"ruby"},{"type":"text","value":"：“"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"bǎo","traditional":"保","type":"ruby"},{"pinyin":"chì","traditional":"赤","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"type":"text","value":"。”"},{"pinyin":"xīn","traditional":"心","type":"ruby"},{"modern":"诚","pinyin":"chéng","traditional":"誠","type":"ruby"},{"pinyin":"qiú","traditional":"求","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"，"},{"modern":"虽","pinyin":"suī","traditional":"雖","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"pinyin":"zhōng","traditional":"中","type":"ruby"},{"pinyin":"bù","traditional":"不","type":"ruby"},{"modern":"远","pinyin":"yuǎn","traditional":"遠","type":"ruby"},{"pinyin":"yǐ","traditional":"矣","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"wèi","traditional":"未","type":"ruby"},{"pinyin":"yǒu","traditional":"有","type":"ruby"},{"modern":"学","pinyin":"xué","traditional":"學","type":"ruby"},{"modern":"养","pinyin":"yǎng","traditional":"養","type":"ruby"},{"pinyin":"zǐ","traditional":"子","type":"ruby"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"modern":"后","pinyin":"hòu","traditional":"後","type":"ruby"},{"pinyin":"jià","traditional":"嫁","type":"ruby"},{"pinyin":"zhě","traditional":"者","type":"ruby"},{"pinyin":"yě","traditional":"也","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Di dalam Kanggao (Khong-koo) tertulis, \"Berlakulah seumpama merawat bayi,\" bila dengan sebulat hati mengusahakannya, meski tidak tepat benar, niscaya tidak jauh dari yang seharusnya. Sesungguhnya tiada yang harus lebih dahulu belajar merawat bayi baru boleh menikah. (V.9.3)."},{"editorial_status":"unverified-draft","id":"sishu.daxue.10.03","number":3,"ruby_paragraphs":[[{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"jiā","traditional":"家","type":"ruby"},{"pinyin":"rén","traditional":"仁","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"modern":"兴","pinyin":"xìng","traditional":"興","type":"ruby"},{"pinyin":"rén","traditional":"仁","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"jiā","traditional":"家","type":"ruby"},{"modern":"让","pinyin":"ràng","traditional":"讓","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"modern":"兴","pinyin":"xìng","traditional":"興","type":"ruby"},{"modern":"让","pinyin":"ràng","traditional":"讓","type":"ruby"},{"type":"text","value":"；"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"modern":"贪","pinyin":"tān","traditional":"貪","type":"ruby"},{"pinyin":"lì","traditional":"戾","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"pinyin":"zuò","traditional":"作","type":"ruby"},{"modern":"乱","pinyin":"luàn","traditional":"亂","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"modern":"机","pinyin":"jī","traditional":"機","type":"ruby"},{"pinyin":"rú","traditional":"如","type":"ruby"},{"pinyin":"cǐ","traditional":"此","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"cǐ","traditional":"此","type":"ruby"},{"modern":"谓","pinyin":"wèi","traditional":"謂","type":"ruby"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"yán","traditional":"言","type":"ruby"},{"modern":"偾","pinyin":"fèn","traditional":"僨","type":"ruby"},{"pinyin":"shì","traditional":"事","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"yī","traditional":"一","type":"ruby"},{"pinyin":"rén","traditional":"人","type":"ruby"},{"pinyin":"dìng","traditional":"定","type":"ruby"},{"modern":"国","pinyin":"guó","traditional":"國","type":"ruby"},{"type":"text","value":"。"}]],"translation_indonesian":"Bila dalam keluarga saling mengasihi niscaya seluruh negara akan di dalam Cinta Kasih. Bila dalam tiap keluarga saling mengalah, niscaya seluruh negara akan di dalam suasana saling mengalah. Tetapi bilamana orang tamak dan curang, niscaya seluruh negara akan terjerumus ke dalam kekalutan; demikianlah semuanya itu berperanan. Maka dikatakan, sepatah kata dapat merusak perkara dan satu orang dapat berperanan menenteramkan negara. (S.S. XX: 1.5;11:2)"},{"editorial_status":"unverified-draft","id":"sishu.daxue.10.04","number":4,"ruby_paragraphs":[[{"modern":"尧","pinyin":"yáo","traditional":"堯","type":"ruby"},{"type":"text","value":"、"},{"pinyin":"shùn","traditional":"舜","type":"ruby"},{"modern":"帅","pinyin":"shuài","traditional":"帥","type":"ruby"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"rén","traditional":"仁","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"mín","traditional":"民","type":"ruby"},{"modern":"从","pinyin":"cóng","traditional":"從","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"jié","traditional":"桀","type":"ruby"},{"type":"text","value":"、"},{"modern":"纣","pinyin":"zhòu","traditional":"紂","type":"ruby"},{"modern":"帅","pinyin":"shuài","traditional":"帥","type":"ruby"},{"pinyin":"tiān","traditional":"天","type":"ruby"},{"pinyin":"xià","traditional":"下","type":"ruby"},{"pinyin":"yǐ","traditional":"以","type":"ruby"},{"pinyin":"bào","traditional":"暴","type":"ruby"},{"type":"text","value":"，"},{"pinyin":"ér","traditional":"而","type":"ruby"},{"pinyin":"mín","traditional":"民","type":"ruby"},{"modern":"从","pinyin":"cóng","traditional":"從","type":"ruby"},{"pinyin":"zhī","traditional":"之","type":"ruby"},{"type":"text","value":"。"},{"pinyin":"qí","traditional":"其","type":"ruby"},{"pinyin":"suǒ","traditional":"所","type":"ruby"},{"pi